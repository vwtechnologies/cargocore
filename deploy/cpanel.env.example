APP_NAME="CargoCore ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cargo-core.vwisdomtechnology.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CPANEL_DATABASE_NAME
DB_USERNAME=CPANEL_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_APPLICATION_PASSWORD
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30
FILESYSTEM_DISK=local
MAIL_MAILER=log
BCRYPT_ROUNDS=12
